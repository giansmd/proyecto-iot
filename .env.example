# ===== Backend =====
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# ===== Base de datos (PostgreSQL 18) =====
DATABASE_URL=postgres://iot:iot@postgres:5432/iot

# ===== Redis (buffer de frames, colas BullMQ y pub/sub) =====
REDIS_URL=redis://redis:6379

# ===== Dispositivos ESP32 autorizados =====
# Formato: id:clave,id2:clave2  (la clave viaja en el header X-Device-Key)
DEVICE_KEYS=esp32-anaquel-1:cambia-esta-clave

# ===== OpenAI Vision =====
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# low | high | auto  (low = mas barato)
OPENAI_IMAGE_DETAIL=low
OPENAI_MAX_OUTPUT_TOKENS=400
OPENAI_TIMEOUT_MS=20000

# ===== Presupuesto de IA (guardián de costo) =====
OPENAI_BUDGET_USD=1
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60

# ===== Politica de analisis =====
# Minutos por defecto si el dispositivo no define uno
DEFAULT_ANALYSIS_INTERVAL_MINUTES=30
# Segundos por defecto de captura/envio del ESP32 si el dispositivo no define uno
DEFAULT_CAPTURE_INTERVAL_SECONDS=60
# Un frame se considera obsoleto si es mas viejo que (intervalo * este factor)
FRAME_STALE_FACTOR=2

# ===== Frontend =====
# URL publica del backend (para el navegador). En Dokploy sin dominio, dejar vacio y usar el proxy interno.
VITE_API_BASE_URL=
